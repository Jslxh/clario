# Clario Environment Variables Template
# Copy this file to .env for local development

# Application Config
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Relational Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://clario_user:clario_password@localhost:5432/clario_db
POSTGRES_USER=clario_user
POSTGRES_PASSWORD=clario_password
POSTGRES_DB=clario_db
POSTGRES_PORT=5432

# Vector Database Configuration (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Security & Authentication Placeholder
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# LLM & AI Provider Integration Placeholder
LLM_API_KEY=your-api-key-here
